# 이 파일을 복사해서 .env로 저장하고 실제 값을 채운다.
# .env는 .gitignore에 의해 커밋되지 않는다 — 절대 여기(.env.example)에 실제 키를 채우지 말 것.

# Claude API (04_diagnose_claude.py에서 사용, 프로토타입 단계 개인 API 키)
ANTHROPIC_API_KEY=

# Qdrant (로컬 Docker 기본값 예시. RunPod 등 원격 사용 시 URL/API 키로 교체)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=leaflog-diagnosis
