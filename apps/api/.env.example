DATABASE_URL=postgresql://leaflog_user:비밀번호@100.70.205.63:5432/leaflog
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000

# 종 마스터 적재(scripts/ingest) 전용 외부 API 키
# 농사로 OpenAPI — 앱의 EXPO_PUBLIC_NONGSARO_API_KEY 와 같은 키를 쓰되 백엔드 변수로 분리
NONGSARO_API_KEY=
# 국립수목원 오픈API — 미발급이면 비워둘 것 (nature_kna 적재는 자동 skip)
NATURE_KNA_API_KEY=

# S3 — 캐릭터 이미지 presigned URL 발급용
S3_BUCKET=your-bucket-name
S3_REGION=ap-northeast-2
S3_PRESIGN_EXPIRE_SECONDS=3600
# 백엔드 직접 presign 여부 — GetObject 가능한 자격증명이 있을 때만 true
S3_PRESIGN=false
# AWS 자격증명: 환경변수(AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) 또는 AWS_PROFILE 사용
# 버킷 소유 계정에서 s3:GetObject 권한 필요
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# 공공데이터포털(data.go.kr) — 디코딩된 서비스키를 그대로 넣는다
# 기상청_단기예보 조회서비스 (getUltraSrtFcst)
KMA_API_KEY=
# 한국환경공단_에어코리아_대기오염정보/측정소정보 조회서비스
AIRKOREA_API_KEY=

# 병해충 상담 Visual RAG (ai/diagnosis/) — 학교 랩 PC(Tailscale, DB와 같은 호스트)에 상시 컨테이너로
# 띄운 공용 Qdrant. 로컬 컴퓨터마다 uvicorn을 따로 띄우는 구조라(각자 localhost는 공유되지 않음),
# 팀 전체가 RAG를 쓰려면 반드시 이 공용 인스턴스를 가리켜야 한다. 개인 로컬 Qdrant로 실험할 땐만
# http://localhost:6333로 바꿔 쓸 것.
QDRANT_URL=http://100.70.205.63:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=leaflog-diagnosis

# SDXL 캐릭터 생성 (학교 PC의 FastAPI를 같은 WSL에서 실행하는 기준)
FORGE_API_URL=http://127.0.0.1:7860
CHARACTER_GPU_MODE_COMMAND=/usr/local/bin/leaflog-gpu
CHARACTER_RESTORE_OLLAMA=true
CHARACTER_CANVAS_SIZE=1024
CHARACTER_PREPROCESS_QUALITY=quality
CHARACTER_POSTPROCESS_QUALITY=quality
CHARACTER_FORGE_STARTUP_TIMEOUT_SECONDS=180
CHARACTER_GENERATION_TIMEOUT_SECONDS=600
# 로컬에서 GPU 없이 앱 흐름만 확인할 때만 true
CHARACTER_MOCK_GENERATION=false
# 프록시/S3 없이 FastAPI 정적 파일로 결과를 제공하는 실험용 URL. 비우면 요청 host를 사용한다.
CHARACTER_PUBLIC_BASE_URL=

# 문의하기 메일 발송 (앱 설정 → 도움말 → 문의하기)
# 비워두면 POST /api/inquiries 가 503 을 돌려준다 — 접수된 척하지 않는다.
# Gmail 을 쓴다면 SMTP_PASSWORD 는 계정 비밀번호가 아니라 앱 비밀번호를 넣는다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 587(STARTTLS)이 기본. 465(SMTPS)를 쓰면 SMTP_USE_TLS=false / SMTP_USE_SSL=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 보내는 주소. 비우면 SMTP_USER 를 쓴다 (대부분 계정 주소만 허용한다)
SMTP_FROM=
# 문의를 받을 주소
SUPPORT_EMAIL=
