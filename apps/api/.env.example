DATABASE_URL=postgresql://leaflog_user:비밀번호@100.70.205.63:5432/leaflog
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000

# 종 마스터 적재(scripts/ingest) 전용 외부 API 키
# 농사로 OpenAPI — 앱의 EXPO_PUBLIC_NONGSARO_API_KEY 와 같은 키를 쓰되 백엔드 변수로 분리
NONGSARO_API_KEY=
# 국립수목원 오픈API — 미발급이면 비워둘 것 (nature_kna 적재는 자동 skip)
NATURE_KNA_API_KEY=

# S3 — 캐릭터 이미지 presigned URL 발급용
S3_BUCKET=your-bucket-name
S3_REGION=ap-northeast-2
S3_PRESIGN_EXPIRE_SECONDS=3600
# 백엔드 직접 presign 여부 — GetObject 가능한 자격증명이 있을 때만 true
S3_PRESIGN=false
# AWS 자격증명: 환경변수(AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) 또는 AWS_PROFILE 사용
# 버킷 소유 계정에서 s3:GetObject 권한 필요
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# 공공데이터포털(data.go.kr) — 디코딩된 서비스키를 그대로 넣는다
# 기상청_단기예보 조회서비스 (getUltraSrtFcst)
KMA_API_KEY=
# 한국환경공단_에어코리아_대기오염정보/측정소정보 조회서비스
AIRKOREA_API_KEY=

# 병해충 상담 Visual RAG (ai/diagnosis/) — 로컬 Docker Qdrant 기본값. RunPod 등 원격 전환 시 교체
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=leaflog-diagnosis