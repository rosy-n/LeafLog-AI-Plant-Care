APP_ROLE=api
DATABASE_URL=postgresql+psycopg://<app-user>:<url-encoded-password>@<rds-host>:5432/leaflog?sslmode=verify-full&sslrootcert=/etc/leaflog/global-bundle.pem
SECRET_KEY=
CORS_ORIGINS=https://<web-origin>
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PRESIGN=true
S3_PRESIGN_EXPIRE_SECONDS=3600
CHARACTER_QUEUE_URL=
CHARACTER_WORKER_TOKEN=
CHARACTER_LEASE_SECONDS=180
CHARACTER_MAX_ATTEMPTS=3
CHARACTER_JOB_TIMEOUT_SECONDS=3600
CHARACTER_QUEUE_LIMIT=20
CHARACTER_DISPATCH_SECONDS=30
AI_WORKER_URL=http://<school-private-address>:8010
AI_WORKER_TOKEN=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=leaflog-diagnosis
NONGSARO_API_KEY=
NATURE_KNA_API_KEY=
KMA_API_KEY=
AIRKOREA_API_KEY=
