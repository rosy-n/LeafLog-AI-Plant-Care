{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeCharacterJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-2:<aws-account-id>:<character-queue-name>"
    }
  ]
}
