server {
    listen 80 default_server;
    server_name __PUBLIC_IP__;
    server_tokens off;
    access_log off;
    client_max_body_size 1k;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/leaflog-acme;
        default_type text/plain;
        try_files $uri =404;
        limit_except GET { deny all; }
    }

    # Do not forward credentials or uploads received over plain HTTP.
    location / { return 404; }
}

server {
    listen 443 ssl default_server;
    server_name __PUBLIC_IP__;
    server_tokens off;
    access_log off;
    client_max_body_size 16m;
    client_body_timeout 60s;

    ssl_certificate /etc/letsencrypt/live/leaflog-api-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/leaflog-api-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:LeafLogTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Forward only headers set by this proxy, not client-supplied proxy claims.
    proxy_set_header Host __PUBLIC_IP__;
    proxy_set_header X-Forwarded-Host __PUBLIC_IP__;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 360s;
    proxy_buffering off;
    proxy_next_upstream off;

    location = /health { proxy_pass http://127.0.0.1:8000; }
    location /auth/ { proxy_pass http://127.0.0.1:8000; }
    location /api/ { proxy_pass http://127.0.0.1:8000; }
    location /internal/character-jobs/ { proxy_pass http://127.0.0.1:8000; }

    # Do not expose the image lab, local files, or interactive API docs.
    location / { return 404; }
}
